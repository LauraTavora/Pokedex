<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootSplash"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101114">   <!-- fundo sólido p/ não mostrar a “tela do celular” -->

    <!-- container ocupa a TELA TODA -->
    <FrameLayout
        android:id="@+id/pokeballContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- metade de cima (usa ClipDrawable) -->
        <ImageView
            android:id="@+id/ivTop"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:adjustViewBounds="true"
            android:src="@drawable/clip_pokeball_top" />

        <!-- metade de baixo (usa ClipDrawable) -->
        <ImageView
            android:id="@+id/ivBottom"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:adjustViewBounds="true"
            android:src="@drawable/clip_pokeball_bottom" />
    </FrameLayout>

</FrameLayout>
