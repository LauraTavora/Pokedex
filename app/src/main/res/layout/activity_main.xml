<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- ================== CONTEÚDO (ConstraintLayout) ================== -->

    <!-- ================== DRAWER ESQUERDO ================== -->
    <!-- Substitua @layout/drawer_filter pelo seu layout do menu lateral -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/rootContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F6F7F9">

        <!-- Ícone de menu (abre o drawer) -->
        <ImageView
            android:id="@+id/ivMenu"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="16dp"
            android:contentDescription="@string/menu"
            android:src="@drawable/ic_menu"
            app:layout_constraintBottom_toBottomOf="@id/tilSearch"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/tilSearch" />

        <!-- Campo de busca -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilSearch"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="44dp"
            android:layout_marginEnd="12dp"

            app:boxBackgroundMode="outline"
            app:boxBackgroundColor="#FFFFFFFF"
            app:boxStrokeColor="#000000"
            app:boxStrokeWidth="1dp"
            app:boxCornerRadiusTopStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusBottomEnd="14dp"

            app:endIconMode="custom"
            app:endIconDrawable="@drawable/ic_lupa"
            app:endIconContentDescription="@string/search_hint"

            app:layout_constraintStart_toEndOf="@id/ivMenu"
            app:layout_constraintEnd_toStartOf="@id/ivPokeball"
            app:layout_constraintTop_toTopOf="parent"

            app:hintEnabled="true"
            android:hint="@string/search_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etSearch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:inputType="textMultiLine"
                android:imeOptions="actionSearch"

                android:maxLines="4"
                android:minLines="1"

                android:scrollHorizontally="false"
                android:ellipsize="none"

                android:gravity="top|start"
                android:includeFontPadding="false"

                android:paddingStart="16dp"
                android:paddingEnd="48dp"  />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Pokébola pequena à direita da barra -->

        <ImageView
            android:id="@+id/ivPokeball"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="16dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_pokeball"
            app:layout_constraintBottom_toBottomOf="@id/tilSearch"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tilSearch" />

        <!-- Lista de Pokémons -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:clipToPadding="false"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tilSearch"
            app:spanCount="2" />

        <!-- Botão flutuante de BATALHA -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabBattle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="32dp"
            android:layout_marginBottom="32dp"
            android:contentDescription="@string/app_name"
            app:backgroundTint="@color/battle"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:srcCompat="@drawable/ic_battle"
            app:tint="@android:color/white" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <include
        layout="@layout/drawer_filter"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"/>

</androidx.drawerlayout.widget.DrawerLayout>
